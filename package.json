{
  "name": "vincents-vibe-roller",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "build": "vinext build",
    "start": "wrangler dev --config dist/server/wrangler.json",
    "lint": "oxlint",
    "format": "oxfmt",
    "db:generate": "drizzle-kit generate",
    "cf:d1:create": "wrangler d1 create vincentsviberoller",
    "cf:d1:migrate": "pnpm run deploy:prepare && wrangler d1 migrations apply DB --config wrangler.runtime.toml --remote",
    "deploy": "pnpm run build && pnpm run deploy:built",
    "test": "node --test tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "test:integration": "node scripts/test-integration.mjs",
    "test:browser": "playwright test",
    "deploy:prepare": "node scripts/cloudflare.mjs",
    "deploy:built": "pnpm run deploy:prepare && wrangler d1 migrations apply DB --config wrangler.runtime.toml --remote && wrangler deploy --config wrangler.runtime.toml"
  },
  "dependencies": {
    "@base-ui/react": "1.7.0",
    "@shadcn/react": "0.3.0",
    "cannon-es": "0.20.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "date-fns": "4.1.0",
    "drizzle-orm": "0.45.2",
    "embla-carousel-react": "8.5.2",
    "input-otp": "1.4.2",
    "lucide-react": "1.31.0",
    "react": "19.2.6",
    "react-day-picker": "9.8.1",
    "react-dom": "19.2.6",
    "react-resizable-panels": "4.5.8",
    "react-server-dom-webpack": "19.2.6",
    "recharts": "3.8.0",
    "shadcn": "4.18.0",
    "tailwind-merge": "3.6.0",
    "three": "^0.185.1",
    "tw-animate-css": "1.4.0",
    "vinext": "1.0.0-beta.5"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@cloudflare/workers-types": "4.20260515.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/three": "^0.185.4",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "oxfmt": "0.61.0",
    "oxlint": "1.76.0",
    "oxlint-tsgolint": "7.0.2001",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vite": "8.0.13",
    "wrangler": "4.92.0",
    "@playwright/test": "1.58.2"
  },
  "type": "module",
  "packageManager": "pnpm@11.19.0"
}
